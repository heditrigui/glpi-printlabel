<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS: copy to ~/Library/LaunchAgents/, fix the path to glpi-label, then
     launchctl load ~/Library/LaunchAgents/com.github.glpi-label.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.github.glpi-label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/glpi-label</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
